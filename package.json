    "@ai-sdk/moonshotai": "^3.0.42",
    "@ai-sdk/openai": "^4.0.51",
    "@ai-sdk/react": "^4.0.87",
    "@cerebras/cerebras_cloud_sdk": "^1.91.0",
    "@google/generative-ai": "^0.24.1",
    "@iarna/rtf-to-html": "^1.1.0",
    "@sentry/nextjs": "^10.70.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.8",
    "chalk": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "next": "16.3.3",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "swiper": "^14.1.0",
    "tailwind-merge": "^3.6.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.6.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.2",
    "cspell": "^10.1.1",
    "cypress": "^15.21.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^20.11.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint-cli": "^0.49.1",
    "pdf2json": "^4.0.3",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "esbuild": "0.27.2"
  },
  "lint-staged": {
    "!(cypress)/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "vitest related --run --passWithNoTests",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "name": "web",
  "private": true,
  "scripts": {
    "build": "next build",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "dev": "next dev",
    "ingest": "npx tsx scripts/ingest.ts",
    "lint": "eslint",
    "lint:docs": "markdownlint '**/*.md' --ignore node_modules",
    "spell-check": "cspell '**/*.md'",
    "prepare": "husky",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cypress:run",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "transform-dates": "npx tsx scripts/transform-dates.ts",
    "transform-dates:dry-run": "npx tsx scripts/transform-dates.ts --dry-run",
    "transform-dates:rename": "npx tsx scripts/transform-dates.ts --rename",
    "type-check": "tsc --noEmit"
  },
  "version": "0.1.0"
}
